{
  "name": "@media/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cleanup:uploads": "tsx src/jobs/cleanup-expired-uploads.ts",
    "process:media": "tsx src/jobs/process-media.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "pnpm test:architecture && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "usage:aggregate": "tsx src/jobs/aggregate-usage.ts",
    "usage:reconcile": "tsx src/jobs/reconcile-usage.ts",
    "quota:release-expired": "tsx src/jobs/release-expired-reservations.ts",
    "subscriptions:renew-periods": "tsx src/jobs/renew-subscriptions.ts",
    "usage:send-alerts": "tsx src/jobs/send-usage-alerts.ts",
    "payments:generate-renewals": "tsx src/jobs/generate-renewal-invoices.ts",
    "payments:expire-invoices": "tsx src/jobs/expire-invoices.ts",
    "payments:reconcile-sslcommerz": "tsx src/jobs/reconcile-sslcommerz.ts",
    "seed:admin": "tsx src/scripts/seed-platform-admin.ts",
    "payg:charge": "tsx src/jobs/charge-payg.ts",
    "test:architecture": "node scripts/check-test-location.mjs && node scripts/check-module-architecture.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts"
  },
  "dependencies": {
    "@media/database": "workspace:*",
    "@redis/client": "^6.1.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.5",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.19",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
