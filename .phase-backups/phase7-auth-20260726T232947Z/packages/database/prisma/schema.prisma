generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum UploadStatus {
  ACTIVE
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum VariantStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum VariantKind {
  THUMBNAIL
  PREVIEW
}

model User {
  id                         String                   @id @default(cuid())
  name                       String
  email                      String
  normalizedEmail            String                   @unique
  passwordHash               String
  emailVerifiedAt            DateTime?
  passwordVersion            Int                      @default(1)
  status                     UserStatus               @default(ACTIVE)
  memberships                WorkspaceMember[]
  sessions                   Session[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  mediaAssets                MediaAsset[]             @relation("MediaCreatedBy")
  uploadSessions             UploadSession[]
  apiKeysCreated             ApiKey[]                 @relation("ApiKeyCreatedBy")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model Workspace {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  storageRootKey        String            @unique
  status                WorkspaceStatus   @default(ACTIVE)
  storageLimitBytes     BigInt            @default(107374182400)
  storageUsedBytes      BigInt            @default(0)
  storageReservedBytes  BigInt            @default(0)
  members               WorkspaceMember[]
  folders               Folder[]
  mediaAssets           MediaAsset[]
  uploadSessions        UploadSession[]
  apiKeys               ApiKey[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenFamilyId String
  tokenHash     String    @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ApiKey {
  id             String    @id @default(cuid())
  workspaceId    String
  createdById    String
  name           String
  keyId          String    @unique
  secretHash     String
  prefix         String
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  lastUsedIp     String?
  revokedAt      DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, revokedAt])
  @@index([createdById])
}

model Folder {
  id          String       @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  pathKey     String
  depth       Int          @default(0)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children    Folder[]     @relation("FolderTree")
  mediaAssets MediaAsset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId, parentId])
}

model MediaAsset {
  id                  String          @id @default(cuid())
  workspaceId         String
  folderId            String?
  createdById         String
  originalFilename    String
  storageKey          String          @unique
  contentType         String
  detectedContentType String?
  detectedMediaType   MediaType
  visibility          MediaVisibility @default(PRIVATE)
  width               Int?
  height              Int?
  durationSeconds     Float?
  sizeBytes           BigInt
  checksumSha256      String?
  status              MediaStatus     @default(UPLOADING)
  deletedAt           DateTime?
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder              Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy           User            @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  uploadSessions      UploadSession[]
  variants            MediaVariant[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, folderId, createdAt, id])
  @@index([workspaceId, status])
  @@index([workspaceId, checksumSha256])
  @@index([workspaceId, visibility, status])
}

model MediaVariant {
  id            String        @id @default(cuid())
  mediaAssetId  String
  kind          VariantKind
  format        String
  width         Int
  height        Int
  quality       Int
  storageKey    String        @unique
  sizeBytes     BigInt?
  status        VariantStatus @default(PENDING)
  errorMessage  String?
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([mediaAssetId, kind])
  @@index([status, createdAt])
}

model UploadSession {
  id             String       @id @default(cuid())
  workspaceId    String
  userId         String
  mediaAssetId   String
  expectedBytes  BigInt
  receivedBytes  BigInt       @default(0)
  chunkSizeBytes Int
  expectedChunks Int
  receivedChunks Int          @default(0)
  status         UploadStatus @default(ACTIVE)
  tempStorageKey String       @unique
  expiresAt      DateTime
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  chunks         UploadChunk[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([expiresAt])
}

model UploadChunk {
  id              String        @id @default(cuid())
  uploadSessionId String
  chunkIndex      Int
  sizeBytes       Int
  checksumSha256  String
  storageKey      String        @unique
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([uploadSessionId, chunkIndex])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  severity  String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
