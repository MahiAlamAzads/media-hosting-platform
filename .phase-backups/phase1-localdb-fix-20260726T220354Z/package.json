{
  "name": "media-hosting-platform",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @media/api --filter @media/web dev",
    "build": "pnpm --filter @media/database build && pnpm --filter @media/api build && pnpm --filter @media/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @media/database generate",
    "db:migrate": "pnpm --filter @media/database prisma migrate dev",
    "db:deploy": "pnpm --filter @media/database prisma migrate deploy",
    "db:check": "pnpm --filter @media/database db:check",
    "verify:phase1": "pnpm db:generate && pnpm db:check && pnpm typecheck && pnpm build"
  }
}
