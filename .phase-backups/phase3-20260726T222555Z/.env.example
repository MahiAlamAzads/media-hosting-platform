NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Neon pooled URL for application runtime. The hostname usually contains "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional Neon direct URL for Prisma migrations. If omitted, DATABASE_URL is used.
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

ACCESS_TOKEN_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000

MEDIA_STORAGE_ROOT=./storage
MEDIA_STORAGE_RESERVED_BYTES=10737418240

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Media Platform
SMTP_FROM_EMAIL=no-reply@example.com
