NODE_ENV=development
WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
CDN_PUBLIC_URL=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://mahi:1234@localhost:5432/media_platform
DIRECT_URL=
ACCESS_TOKEN_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_PEPPER=replace-with-an-independent-random-secret
REFRESH_TOKEN_TTL_DAYS=30
API_KEY_PEPPER=replace-with-an-independent-api-key-pepper
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Redis performance layer (supports redis:// and rediss:// URLs)
REDIS_URL=
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=media-platform
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_PUBLIC_MEDIA_TTL_SECONDS=300
REDIS_PUBLIC_VARIANT_TTL_SECONDS=3600
REDIS_PRICING_TTL_SECONDS=300
REDIS_AUTH_TOUCH_TTL_SECONDS=300
REDIS_USAGE_ALERT_DEBOUNCE_SECONDS=2
REDIS_LOCAL_CACHE_MAX_ENTRIES=1000
REDIS_LOCAL_CACHE_FALLBACK_TTL_SECONDS=5

# Automatic image optimization (original files are preserved)
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_OPTIMIZATION_CONCURRENCY=2
IMAGE_OPTIMIZATION_SWEEP_INTERVAL_MS=15000
IMAGE_OPTIMIZATION_BATCH_SIZE=25
IMAGE_OPTIMIZATION_LOCK_TTL_SECONDS=600
IMAGE_OPTIMIZATION_OUTPUT_FORMAT=webp
IMAGE_OPTIMIZATION_EFFORT=4
IMAGE_OPTIMIZATION_MAX_INPUT_PIXELS=100000000
IMAGE_THUMBNAIL_MAX_SIZE=320
IMAGE_THUMBNAIL_QUALITY=78
IMAGE_PREVIEW_MAX_SIZE=1600
IMAGE_PREVIEW_QUALITY=82
PLATFORM_ADMIN_EMAILS=
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_PROOF_REQUIRED=true
MANUAL_PAYMENT_PROOF_MAX_BYTES=5242880
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_AUTO_APPROVE_RISKY=false
PAYMENT_RENEWAL_LEAD_DAYS=7
PAYMENT_GRACE_DAYS=7
MEDIA_STORAGE_ROOT=./storage
MEDIA_STORAGE_RESERVED_BYTES=10737418240
MEDIA_SIGNING_SECRET=replace-with-an-independent-64-character-signing-secret
DELIVERY_TOKEN_TTL_SECONDS=900
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Media Platform
SMTP_FROM_EMAIL=no-reply@example.com

# Legacy tokenized-card adapter (kept disabled; Phase 14 uses prepaid wallet PAYG)
PAYG_ENABLED=true
PAYG_CARD_PROVIDER=STRIPE
PAYG_DEFAULT_MONTHLY_CAP_BDT_MINOR=500000
PAYG_DEFAULT_MONTHLY_CAP_USD_MINOR=5000
PAYG_DEFAULT_CHARGE_THRESHOLD_BDT_MINOR=50000
PAYG_DEFAULT_CHARGE_THRESHOLD_USD_MINOR=500
PAYG_AUTHORIZATION_TTL_MINUTES=30
PAYG_PROCESSING_AUTHORIZATION_MILLISECONDS=60000

# Stripe card vault (optional; requires a supported Stripe account)
STRIPE_PAYG_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 14 prepaid PAYG and Enterprise sales
PAYG_MINIMUM_TOPUP_BDT_MINOR=50000
PAYG_MINIMUM_TOPUP_USD_MINOR=500
PAYG_LOW_BALANCE_BDT_MINOR=10000
PAYG_LOW_BALANCE_USD_MINOR=100
ENTERPRISE_SALES_EMAIL=sales@example.com
